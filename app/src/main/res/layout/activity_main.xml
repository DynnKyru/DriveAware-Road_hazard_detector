<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/view_finder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter"
		app:implementationMode="performance"/>
	
	<!-- Different notifcard -->
	<androidx.cardview.widget.CardView
    android:id="@+id/notificationBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="50dp"
    android:layout_marginHorizontal="10dp"
    android:elevation="10dp"
    android:backgroundTint="#66000000"
    app:cardCornerRadius="16dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:visibility="visible">

    <TextView
        android:id="@+id/detectingLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/detecting"
        android:textColor="@android:color/white"
        android:textSize="19sp"
		android:padding="3dp"
        android:textStyle="bold"
        android:gravity="center"/>
	</androidx.cardview.widget.CardView>
	
    <!-- Notification Card (Overlay) -->
    <androidx.cardview.widget.CardView
    android:id="@+id/detectionNotificationCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="50dp"
    android:layout_marginHorizontal="10dp"
    android:visibility="gone"
    android:elevation="10dp"
    app:cardCornerRadius="16dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    android:layout_gravity="center_horizontal">
		
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/detectionIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:tint="@android:color/white"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/detectionNotificationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/detected"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:gravity="center_horizontal"
            android:textStyle="bold"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>

    <!-- Frame Layout for Capturing -->
    <FrameLayout
        android:id="@+id/frame_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/view_finder"
        app:layout_constraintBottom_toBottomOf="@id/view_finder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Overlay View for Object Detection -->
    <com.DynnKyru.driveAware.OverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:translationZ="5dp"
        app:layout_constraintTop_toTopOf="@id/view_finder"
        app:layout_constraintBottom_toBottomOf="@id/view_finder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Inference Speed Display -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!--Map Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mapButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="28dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.77"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintEnd_toEndOf="parent"
    >
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_map"/>
    </com.google.android.material.card.MaterialCardView>


    <!--Settings Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/settingsButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="28dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.86"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_settings"/>
    </com.google.android.material.card.MaterialCardView>


    <!--Sound Button -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/soundMenuContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="17dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/button_foreground"
        app:layout_constraintTop_toBottomOf="@id/settingsButton"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- BEEP -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/beepButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:visibility="gone"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/voiceButton"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_beep"
                android:contentDescription="Beep mode"/>
        </com.google.android.material.card.MaterialCardView>
        <!-- VOICE -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/voiceButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:visibility="gone"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/soundButton"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_voice"
                android:contentDescription="Voice mode"/>
        </com.google.android.material.card.MaterialCardView>


        <!-- SILENT -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/silentButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:visibility="gone"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/beepButton"
            android:layout_marginEnd="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_silent"
                android:contentDescription="Silent mode"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- MAIN SOUND BUTTON -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/soundButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/soundIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="Sound Icon"
                android:src="@drawable/ic_sound"/>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- GPU -->
    <androidx.cardview.widget.CardView
        android:id="@+id/gpuCard"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="28dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/soundMenuContainer"
        app:layout_constraintTop_toTopOf="@+id/soundMenuContainer">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        <ToggleButton
            android:id="@+id/isGpu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/circular_toggle_background"
            android:checked="true"
            android:textColor="@android:color/black"
            android:textOff="@string/gpu"
            android:textOn="@string/gpu"
            android:textStyle="bold"
            android:textSize="16sp"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>
