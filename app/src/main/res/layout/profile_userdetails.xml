<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/dialogbg">

    <!-- ✅ Top Container for Cancel Button (Right) & Center Button (Middle) -->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">



        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="120dp"
            android:text="User Details"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuTitlee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Prof"
            android:textColor="#FFFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/cancelMenuButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="17dp"
            android:layout_marginEnd="240dp"
            android:src="@drawable/ic_exit" />


    </LinearLayout>




    <!-- Profile Container -->
    <LinearLayout
        android:id="@+id/layoutUsername"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="15dp"
        android:padding="20dp"
        android:elevation="4dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/UserPicture"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/profile"
                android:layout_marginEnd="-10dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Name Field -->
    <LinearLayout
        android:id="@+id/layoutNamefield"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="Name"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_weight="1"
            android:gravity="start"/>

        <EditText
            android:id="@+id/editTextName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="Enter Name"
            android:background="@android:drawable/edit_text"
            android:padding="8dp"/>
    </LinearLayout>

    <!-- Email Address Field -->
    <LinearLayout
        android:id="@+id/layoutEmailfield"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="Email Address"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_weight="1"
            android:gravity="start"/>

        <EditText
            android:id="@+id/editTextEmail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="Enter Email"
            android:background="@android:drawable/edit_text"
            android:padding="8dp"
            android:inputType="textEmailAddress"/>
    </LinearLayout>

    <!-- Password Field -->
    <LinearLayout
        android:id="@+id/layoutPasswordfield"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="Password"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_weight="1"
            android:gravity="start"/>

        <EditText
            android:id="@+id/editTextPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="Enter Password"
            android:background="@android:drawable/edit_text"
            android:padding="8dp"
            android:inputType="textPassword"/>
    </LinearLayout>

    <!-- Change Password Field -->
    <LinearLayout
        android:id="@+id/layoutChangepasswordfield"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="Change Password"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_weight="1"
            android:gravity="start"/>

        <EditText
            android:id="@+id/editTextChangePassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="Change Password"
            android:background="@android:drawable/edit_text"
            android:padding="8dp"
            android:inputType="textPassword"/>
    </LinearLayout>

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp">

        <!-- Clear Button with Shadow -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardElevation="6dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="@android:color/white">

            <Button
                android:id="@+id/clearbutton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear"
                android:backgroundTint="@color/white"
                android:textColor="@android:color/black"
                android:padding="10dp"
                android:elevation="0dp" />
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="16dp"
            android:layout_height="wrap_content"/>

        <!-- Change Button with Shadow -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardElevation="6dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="@android:color/white">

            <Button
                android:id="@+id/changeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Change"
                android:backgroundTint="@color/white"
                android:textColor="@android:color/black"
                android:padding="10dp"
                android:elevation="0dp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>
