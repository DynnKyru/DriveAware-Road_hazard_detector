<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/dialogbg">

    <!-- ✅ Top Container for Cancel Button (Right) & Center Button (Middle) -->


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/Backbutton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="-1dp"
            android:clickable="true"
            android:src="@drawable/back_arrow" />

        <TextView
            android:id="@+id/menuTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="85dp"
            android:text="User Details"
            android:textColor="#000000"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/cancelMenuButton"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="90dp"
            android:src="@drawable/ic_exit" />

    </LinearLayout>

    <!-- Profile Container -->
    <LinearLayout
        android:id="@+id/layoutUsername"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="5dp"
        android:padding="5dp"
        android:elevation="4dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/UserPicture"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/profile"
                android:layout_marginEnd="0dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Name Text -->
    <LinearLayout
        android:id="@+id/layoutName"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="1dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:layout_weight="1"
            android:gravity="start"
            android:text="Name"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Name Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutNamefield"
        android:background="@drawable/border_rounded"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="1dp"
        android:gravity="center_vertical">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextName"
            android:layout_width="367dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/border_rounded_gray"
            android:elevation="0dp"
            android:hint="Enter Name"
            android:padding="12dp"/>
    </com.google.android.material.textfield.TextInputLayout>


    <!-- Email Address Text -->
    <LinearLayout
        android:id="@+id/layoutEmail"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="1dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:text="Email Address"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_weight="1"
            android:gravity="start"/>

    </LinearLayout>
    <!-- Email Address Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutEmailfield"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="1dp"
        android:gravity="center_vertical">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextEmail"
            android:layout_width="366dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/border_rounded_gray"
            android:elevation="0dp"
            android:hint="Enter Email"
            android:inputType="textEmailAddress"
            android:padding="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password Text -->
    <LinearLayout
        android:id="@+id/layoutPasswordfield"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="1dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:text="Password"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_weight="1"
            android:gravity="start"/>


    </LinearLayout>
    <!-- Password Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutPassword"
        android:layout_marginBottom="5dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:passwordToggleEnabled="true"
        android:padding="1dp"
        android:gravity="center_vertical">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextPassword"
            android:layout_width="369dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/border_rounded_gray"
            android:hint="Enter Password"
            android:elevation="0dp"
            android:inputType="textPassword"
            android:padding="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Change Password Text -->
    <LinearLayout
        android:id="@+id/layoutChangepassword"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="1dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:text="Change Password"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_weight="1"
            android:gravity="start"/>

    </LinearLayout>
    <!-- Change Password Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutChangepasswordfield"
        android:background="@drawable/border_rounded"
        app:passwordToggleEnabled="true"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="1dp"
        android:gravity="center_vertical">


        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextChangePassword"
            android:layout_width="367dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:background="@drawable/border_rounded_gray"
            android:elevation="0dp"
            android:hint="Change Password"
            android:inputType="textPassword"
            android:padding="12dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="16dp">

        <!-- Clear Button with Shadow -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="@android:color/white">

            <Button
                android:id="@+id/clearbutton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clear"
                android:backgroundTint="@color/white"
                android:textColor="@android:color/black"
                android:padding="10dp"
                android:elevation="0dp" />
        </androidx.cardview.widget.CardView>

        <View
            android:layout_width="16dp"
            android:layout_height="wrap_content"/>

        <!-- Change Button with Shadow -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="@android:color/white">

            <Button
                android:id="@+id/changeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Change"
                android:backgroundTint="@color/white"
                android:textColor="@android:color/black"
                android:padding="10dp"
                android:elevation="0dp" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</LinearLayout>
