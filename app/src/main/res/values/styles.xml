<resources>
    <style name="Theme.SplashScreen" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
    </style>

    <!-- Fullscren MainActivity -->
    <style name="Theme.DriveAware.Transparent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item> <!-- Set to true for black icons -->
    </style>
    <!-- Custom Switch Style -->
    <style name="CustomSwitchStyle">
        <item name="colorControlActivated">@color/green</item>
        <item name="colorControlNormal">@color/red</item>
    </style>

    <!-- Light Theme -->
    <style name="LightTheme" parent="Theme.AppCompat.Light">
        <!-- Customize your light theme here -->
    </style>

    <!-- Dark Theme -->
    <style name="DarkTheme" parent="Theme.AppCompat.NoActionBar">
        <!-- Customize your dark theme here -->
    </style>
    <style name="DialogAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_from_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_from_right</item>
    </style>
</resources>
