<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.YoloV9Tflite" parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Primary brand color -->
        <item name="colorPrimary">@color/lavender</item>
        <item name="colorPrimaryVariant">@color/lavender</item>
        <item name="colorOnPrimary">@color/white</item>


        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!--  Transparent color top -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- ✅ Enables light status bar icons (set false if background is light) -->
        <item name="android:windowLightStatusBar">true</item>

        <!-- Transparent Color bottom -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.YoloV9Tflite" parent="Base.Theme.YoloV9Tflite" />

</resources>
